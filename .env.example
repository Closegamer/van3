# Скопируйте в .env (не коммитится). Для npm run check-db и provision_vandb.mjs.

# --- Подключение к Postgres (после docker compose на сервере) ---
VAN_DB_HOST=
VAN_DB_PORT=5432
VAN_DB_NAME=vandb
VAN_DB_USER=vanuser
VAN_DB_PASSWORD=

# --- scripts/provision_vandb.mjs (админ: роль vanuser и БД vandb на существующем кластере) ---
# VAN_PG_ADMIN_DATABASE — существующая БД для первого подключения (часто postgres).
VAN_PG_ADMIN_HOST=
VAN_PG_ADMIN_PORT=5432
VAN_PG_ADMIN_USER=
VAN_PG_ADMIN_PASSWORD=
VAN_PG_ADMIN_DATABASE=

# --- Docker на сервере: см. .env.docker.example и DEPLOY.md ---
