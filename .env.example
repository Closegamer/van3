# Скопируйте в .env и заполните. Файл .env не коммитится.

# --- Несколько машин / один Postgres ---
# Если заданы VAN_DB_HOST и VAN_DB_PASSWORD, скрипт сам включает режим базы (как -UseDatabase).
# Отключить: VAN_USE_DATABASE=0
# Имя воркера в БД (по умолчанию — COMPUTERNAME): VAN_WORKER_ID=gpu-box-01
DB_ENGINE=Postgres
VAN_DB_HOST=
VAN_DB_PORT=5432
VAN_DB_NAME=vandb
VAN_DB_USER=vanuser
VAN_DB_PASSWORD=
# VAN_USE_DATABASE=1
# VAN_WORKER_ID=
# Импорт completed.txt → van_ranges (опционально): VAN_IMPORT_WORKER_ID=completed-txt-import
# С БД пройденные по умолчанию только из van_ranges; плюс completed.txt: VAN_USE_LOCAL_COMPLETED_FILE=1
# ODBC (если IM002): VAN_ODBC_DRIVER={PostgreSQL Unicode}

# --- scripts/provision_vandb.mjs (админ кластера: создание vanuser / vandb) ---
# VAN_PG_ADMIN_DATABASE — любая уже существующая БД на том же сервере, куда можно зайти этим пользователем (часто не postgres).
VAN_PG_ADMIN_HOST=
VAN_PG_ADMIN_PORT=5432
VAN_PG_ADMIN_USER=
VAN_PG_ADMIN_PASSWORD=
VAN_PG_ADMIN_DATABASE=

# --- Docker (автономный Postgres + vandb на сервере) ---
# См. .env.docker.example и DEPLOY.md. На каждой машине с run_van.ps1: VAN_DB_HOST = публичный IP/DNS сервера
# VAN_DB_PASSWORD должен совпадать с POSTGRES_PASSWORD в .env.docker
