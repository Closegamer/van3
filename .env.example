# Скопируйте в .env и заполните. Файл .env не коммитится.

# --- run_vanity.ps1 (-UseDatabase) ---
DB_ENGINE=Postgres
VANITY_DB_HOST=
VANITY_DB_PORT=5432
VANITY_DB_NAME=vandb
VANITY_DB_USER=vanuser
VANITY_DB_PASSWORD=

# --- scripts/provision_vandb.mjs (админ кластера: создание vanuser / vandb) ---
# VANITY_PG_ADMIN_DATABASE — любая уже существующая БД на том же сервере, куда можно зайти этим пользователем (часто не postgres).
VANITY_PG_ADMIN_HOST=
VANITY_PG_ADMIN_PORT=5432
VANITY_PG_ADMIN_USER=
VANITY_PG_ADMIN_PASSWORD=
VANITY_PG_ADMIN_DATABASE=

# --- Docker (автономный Postgres + vandb на сервере) ---
# См. .env.docker.example и DEPLOY.md. После compose: VANITY_DB_HOST=IP_сервера (или 127.0.0.1)
# VANITY_DB_PASSWORD должен совпадать с POSTGRES_PASSWORD в .env.docker
