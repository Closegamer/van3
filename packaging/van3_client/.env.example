# Скопируйте в .env и заполните (рядом с run_van.ps1).

DB_ENGINE=Postgres
VAN_DB_HOST=
VAN_DB_PORT=5432
VAN_DB_NAME=vandb
VAN_DB_USER=vanuser
VAN_DB_PASSWORD=

# Режим БД включается сам при VAN_DB_HOST + VAN_DB_PASSWORD. Отключить: VAN_USE_DATABASE=0
# Имя воркера в van_ranges (иначе — COMPUTERNAME):
# VAN_WORKER_ID=gpu-box-01
# Редко: снова учитывать локальный completed.txt — VAN_USE_LOCAL_COMPLETED_FILE=1
