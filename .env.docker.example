# Переменные для docker compose (скопируйте в .env.docker, не коммитьте .env.docker).
# Образ postgres:16 создаёт пользователя, БД и прогоняет docker/initdb/*.sql при первом запуске.

POSTGRES_USER=vanuser
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=vandb

# Публикация порта: "5432" или "127.0.0.1:5432" или "55432" если на хосте уже занят 5432
VANITY_POSTGRES_PUBLISH=5432
