# Переменные для docker compose (скопируйте в .env.docker, не коммитьте .env.docker).
# Образ postgres:16 создаёт пользователя, БД и прогоняет docker/initdb/*.sql при первом запуске.

POSTGRES_USER=vanuser
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=vandb

# Публикация порта Docker → хост:
#   5432 — слушать на всех интерфейсах (удалённые воркеры смогут подключиться при открытом фаерволе)
#   127.0.0.1:5432 — только с самого сервера (удалённые run_van.ps1 не достучатся)
#   55432 — если порт 5432 на хосте занят
VAN_POSTGRES_PUBLISH=5432
